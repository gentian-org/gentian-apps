apiVersion: gentianos.io/v1alpha1
kind: AppProfile
metadata:
  name: odoo-website-ce
  labels:
    gentianos.io/profile-name: odoo-website-ce
  annotations:
    gentianos.io/platform-app: "false"
    gentianos.io/deployment-role: addon
    # Read from addons/website/security/website_security.xml:
    # group_website_restricted_editor is "Restricted Editor" and
    # group_website_designer is "Editor and Designer". The designer group
    # declares implied_ids onto the restricted editor, so the admin tier already
    # subsumes the member tier and each is declared where it belongs.
    gentianos.io/keycloak-group-attributes: '{"gentianOdooAdminRoles":["website.group_website_designer"],"gentianOdooGroupRoles":["website.group_website_restricted_editor"],"gentianOdooModules":["website"]}'
    gentianos.io/portal-auth-mode: oidc
spec:
  displayName: "Odoo Website"
  description: "Website builder for a tenant's public homepage, in Odoo."
  family: odoo
  catalogueVersion: "1.0.0"
  edition: ce
  trustTier: platform
  license: LGPL-3.0
  author: OCA
  tile:
    image: assets/tile.png
    logo: data:image/png;base64,

  portalTiles:
    - name: odoo-website
      displayName:
        en_US: "Odoo Website"
        de_DE: "Odoo Website"
      # The builder, which is what Odoo's own Website icon opens:
      # menu_website_configuration -> menu_site -> menu_website_preview at
      # sequence 10. An ir.actions.client (tag website_preview) rather than an
      # act_window -- the first client action among these addons -- but
      # /odoo/action-<xmlid> addresses it the same way, and every tile in this
      # family is an explicit action path for the same reason.
      #
      # This tile is the editor, not the published site. The site is served to
      # anonymous visitors off the base's ingress and has no tile: a homepage is
      # not something a signed-in member opens from the launcher.
      linkSuffix: "/odoo/action-website.website_preview?gentian_embed=1"
      linkTarget: embedded
      allowedGroup: "App Users"

  compositionRef: app-odoo-base-ce
  deploymentMethod: crossplane
  chart:
    repository: oci://ghcr.io/gentian-org/charts
    name: odoo
    version: "0.1.15"
  # Odoo calls its addons "modules" — this maps the Gentian profile onto that name.
  customization:
    addon:
      id: website
      of: odoo-base-ce
  extraValues:
    odoo:
      module: website
    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        cpu: 250m
        memory: 256Mi
