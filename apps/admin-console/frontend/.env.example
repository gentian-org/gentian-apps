# Local development only. Behind the platform's edge every value the bundle
# needs arrives at container start through /config.js, rendered from the
# environment by docker-entrypoint.sh; nothing is set at build time.
# VITE_AUTH_DISABLED=true
# VITE_AUTH_MODE=pkce
# VITE_OIDC_ISSUER=https://id.<kernel-domain>/auth/realms/<realm>
# VITE_OIDC_CLIENT_ID=
