# The tag CI publishes this image under on a release, and the one the
# profile asks for (scripts/validate-image-tags.py reads it). Keep it equal
# to charts/cadcraft/Chart.yaml's appVersion.
IMAGE_TAG=0.20.1
# The upstream release served: storytold/cadcraft, tag v0.20.1. Its web build
# is the release asset cadcraft-web-0.20.1.zip. The image is built from
# images/crafting-apps with these values.
CRAFT_VERSION=0.20.1
# SHA-256 of that asset, as the release's SHA256SUMS.txt lists it. The build
# fails when the download differs.
CRAFT_WEB_SHA256=300e870c50b66d371055915ba95e3ddbfd4c45431466d5214743b5dcab95a0e1
# The name a person reads, and the file name endings the app opens: what the
# file dialog of the framing page lists.
CRAFT_TITLE=CADCraft
CRAFT_EXTENSIONS=.dxf,.dwg,.dwt,.svg,.svgz
