# The tag CI publishes this image under on a release, and the one the
# profile asks for (scripts/validate-image-tags.py reads it). Keep it equal
# to charts/uno-calculator/Chart.yaml's appVersion.
IMAGE_TAG=1.2.4-c32d9b2
# The upstream commit built: unoplatform/calculator, branch "uno", 2025-08-19.
# Upstream has tagged no release since 1.2.4-uno.725 (2020); the branch head
# is what https://calculator.platform.uno serves.
CALCULATOR_COMMIT=c32d9b20ee49a394370afd5e73cd7d2f48507cc8
# Must match the emscripten of the .NET 9 wasm workload (upstream's
# .vsts-ci.Linux.yml pins the same).
EMSDK_VERSION=3.1.56
