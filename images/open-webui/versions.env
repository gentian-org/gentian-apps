# Pinned upstream version for the Gentian Open WebUI image.
# Keep in sync with profiles/open-webui/open-webui-ce/profile.yaml (image.tag)
# and the FROM lines of the Dockerfile.
#
# OPEN_WEBUI_VERSION  upstream release whose frontend is rebuilt with patches/
# OPEN_WEBUI_COMMIT   the commit that release tag must name; the build fails otherwise
# IMAGE_TAG           tag published to ghcr.io/gentian-org/open-webui
OPEN_WEBUI_VERSION=0.10.2
OPEN_WEBUI_COMMIT=ecd48e2f718220a6400ecf49eafd4867a38feb10
IMAGE_TAG=0.10.2-slim-gentian1
