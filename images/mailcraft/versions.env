# The tag CI publishes this image under on a release, and the one the
# profile asks for (scripts/validate-image-tags.py reads it). Keep it equal
# to charts/mailcraft/Chart.yaml's appVersion.
IMAGE_TAG=0.15.0
# The upstream release served: UCS-Care-Group/mailcraft, tag v0.15.0. Its web
# build is the release asset mailcraft-web-0.15.0.zip.
MAILCRAFT_VERSION=0.15.0
# SHA-256 of that asset, as the release's SHA256SUMS.txt lists it. The build
# fails when the download differs.
MAILCRAFT_WEB_SHA256=9c9cf9940700af68183d69ea148b5c2e56279d53d2bdb82608271dcb73f80f84
