# Pinned upstream versions for the Gentian XWiki bundle image.
# Keep in sync with profiles/xwiki/profile.yaml (image.tag) and the Dockerfile ARG defaults.
#
# XWIKI_VERSION       base image tag (xwiki:<v>-postgres-tomcat) AND the Standard Flavor
#                     XIP version — the two MUST match or the offline flavor install fails.
# FLAVOR_XIP_SHA256   integrity check for the downloaded Standard Flavor XIP.
# OIDC_VERSION        org.xwiki.contrib.oidc:oidc-authenticator version bundled as a
#                     core extension (all its runtime deps are JARs — no wiki pages).
# IMAGE_TAG           tag published to ghcr.io/gentian-org/xwiki.
XWIKI_VERSION=17.10.9
FLAVOR_XIP_SHA256=f3b86bfdc6dc7348c0deb31134afc8a8ddd0fb05f39ab6d0cc1f87f98dcd8a22
OIDC_VERSION=2.20.2
IMAGE_TAG=17.10.9-gentian1
