# The tag CI publishes this image under on a release, and the one the
# profile asks for (scripts/validate-image-tags.py reads it). Keep it equal
# to charts/super-productivity/Chart.yaml's appVersion.
IMAGE_TAG=20.1.0
# The upstream image whose web build is served: johannesjo/super-productivity,
# tag v20.1.0, by the digest of its index. The build fails when the tag has
# been moved.
SP_IMAGE=docker.io/johannesjo/super-productivity:v20.1.0@sha256:6592ab5929bad174260cdc07b30c9c9b8943c7dba82596eddcb6a75d439d1756
