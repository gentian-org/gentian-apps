# The tag CI publishes this image under on a release, and the one the
# profile asks for (scripts/validate-image-tags.py reads it). Keep it equal
# to charts/vectorcraft/Chart.yaml's appVersion.
IMAGE_TAG=0.24.1
# The upstream release served: storytold/vectorcraft, tag v0.24.1. Its web build
# is the release asset vectorcraft-web-0.24.1.zip.
VECTORCRAFT_VERSION=0.24.1
# SHA-256 of that asset, as the release's SHA256SUMS.txt lists it. The build
# fails when the download differs.
VECTORCRAFT_WEB_SHA256=de31befd175476f252e3563b4b1fdc6c887d5842b33fb7d1f5fdf007dc7633aa
