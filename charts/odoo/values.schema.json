{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gentian Odoo chart values",
  "description": "Rung L0 of the customization ladder for Odoo. See gentian-os/docs/app-customization.md and profiles/odoo-cb-base/customization.md.",
  "type": "object",
  "additionalProperties": true,
  "required": ["image", "existingSecret", "gentian"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "tenantId": { "type": "string" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "existingSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "database": {
      "type": "object",
      "description": "Set via valueMapping from OpenBao, not authored directly on a profile.",
      "properties": {
        "host": { "type": "string" },
        "port": { "type": "string" },
        "name": { "type": "string" },
        "user": { "type": "string" },
        "password": { "type": "string" }
      }
    },
    "oidc": {
      "type": "object",
      "properties": {
        "issuer": { "type": "string" },
        "clientId": { "type": "string" },
        "clientSecret": { "type": "string" }
      }
    },
    "gentian": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modulesPath", "initModules"],
      "properties": {
        "configPath": { "type": "string" },
        "bindingsPath": { "type": "string" },
        "modulesPath": { "type": "string", "pattern": "^/.*" },
        "initModules": {
          "type": "string",
          "description": "Comma-separated technical module names installed on first boot."
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "repo": { "type": "string" },
            "branch": { "type": "string" },
            "syncInterval": { "type": "integer", "minimum": 0 },
            "secretName": { "type": "string" }
          }
        },
        "gitSources": {
          "type": "array",
          "description": "Multiple module repos (customization ladder rung L3, delivery: git-sidecar).",
          "items": {
            "type": "object",
            "required": ["name", "repo", "branch"],
            "properties": {
              "name": { "type": "string" },
              "repo": { "type": "string" },
              "branch": { "type": "string" },
              "syncInterval": { "type": "integer", "minimum": 0 },
              "secretName": { "type": "string" }
            }
          }
        }
      }
    },
    "dropIns": {
      "type": "object",
      "additionalProperties": false,
      "description": "Rung L1. Odoo has no native conf.d; odooConf fragments are merged into odoo.conf by an init container before start.",
      "properties": {
        "odooConf": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configMaps": { "type": "array", "items": { "type": "string" } }
          }
        },
        "branding": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "configMaps": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "size": { "type": "string" },
        "storageClass": { "type": "string" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "type": "boolean" } }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "resources": { "type": "object" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "podLabels": { "type": "object" }
  }
}
