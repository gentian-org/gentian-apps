Description: Add nginx ConfigMap for portal SSO forwarding and HTTPS redirects
 Activepieces is served inside the Gentian portal behind Envoy Gateway with SAML
 SSO terminated by a sidecar. That needs nginx configuration upstream has no
 reason to ship: forward unauthenticated requests to the SAML login endpoint,
 proxy /api/v1/authn/saml/{login,acs} to the sidecar rather than to the backend,
 expose the git-synced /custom-content mount, map the ?token query parameter onto
 a session cookie so the SPA picks up the sidecar's session, and rewrite backend
 redirects to HTTPS since TLS terminates at the edge.
 The config lives in files/nginx.conf rather than inline in the template: it is
 150 lines of nginx and stays reviewable as a file. Guarded by gentian.enabled,
 which defaults to false, so with default values this changes nothing.
Author: Gentian Platform <platform@gentian.org>
Origin: other, https://github.com/gentian-org/gentian-apps
Forwarded: not-needed
Reason: Gentian portal integration glue — upstream would rightly decline
  deployment-topology-specific nginx configuration.
Applied-Upstream: no
Last-Update: 2026-08-06
---
diff --git a/files/nginx.conf b/files/nginx.conf
new file mode 100644
index 0000000..22350c1
--- /dev/null
+++ b/files/nginx.conf
@@ -0,0 +1,150 @@
+events{}
+http {
+    include /etc/nginx/mime.types;
+    client_max_body_size 4m;
+
+    map $http_accept_language $accept_language {
+        ~*^en en;
+        ~*^fr fr;
+        ~*^it it;
+        ~*^de de;
+        ~*^nl nl;
+        ~*^ja ja;
+        ~*^es es;
+        ~*^id id;
+        ~*^vi vi;
+        ~*^zh zh;
+        ~*^pt pt;
+        ~*^hu hu;
+        ~*^uk uk;
+        ~*^bg bg;
+    }
+
+    map $arg_token $auth_cookie {
+        default "";
+        ~.+ "ap_logged_in=true; Path=/; Secure; SameSite=Lax";
+    }
+
+    server_tokens off;
+
+    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
+    add_header X-Content-Type-Options "nosniff" always;
+
+    server {
+        listen 80;
+        server_name localhost;
+        root /usr/share/nginx/html;
+        index index.html;
+
+        add_header Set-Cookie $auth_cookie always;
+
+        # Server-level cookie auth check (safe from try_files side effects)
+        set $should_redirect "no";
+        if ($request_uri ~* "^/(fr|de|it|pt|nl|ja|es|zh|vi|id|hu|uk|bg)?/?($|flows|connections|sign-in|sign-up|redirect)") {
+            set $should_redirect "yes";
+        }
+        if ($http_cookie ~* "ap_token=") {
+            set $should_redirect "no";
+        }
+        if ($should_redirect = "yes") {
+            return 302 https://$host/api/v1/authn/saml/login;
+        }
+
+        error_page 404 /404.html;
+        location = /404.html {
+            root /usr/share/nginx/html;
+            try_files $uri $uri/ /index.html;
+        }
+
+        location /socket.io {
+            proxy_pass http://localhost:3000/socket.io;
+            proxy_http_version 1.1;
+            proxy_set_header Upgrade $http_upgrade;
+            proxy_set_header Connection "Upgrade";
+            proxy_set_header Host $host;
+        }
+
+        location /custom-content {
+            # /current, because the content is produced by git-sync running in
+            # this pod: it writes each revision to its own directory and swaps a
+            # symlink named "current" to point at it. Serving the parent would
+            # expose the revision directories and the symlink itself; serving
+            # through the symlink is what makes a re-sync atomic for readers.
+            alias /usr/share/nginx/html/custom-content/current;
+            autoindex on;
+            add_header Access-Control-Allow-Origin *;
+        }
+
+        location = /api/v1/authn/saml/login {
+            proxy_pass http://SSO_IP_PLACEHOLDER:8081/sso/login;
+            proxy_set_header Host $host;
+            proxy_set_header X-Real-IP $remote_addr;
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto https;
+        }
+
+        location = /api/v1/authn/saml/acs {
+            proxy_pass http://SSO_IP_PLACEHOLDER:8081/sso/acs;
+            proxy_set_header Host $host;
+            proxy_set_header X-Real-IP $remote_addr;
+            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
+            proxy_set_header X-Forwarded-Proto https;
+        }
+
+        location /api/ {
+            proxy_pass http://localhost:3000/;
+            proxy_http_version 1.1;
+            proxy_set_header Upgrade $http_upgrade;
+            proxy_set_header Connection "Upgrade";
+            proxy_set_header Host $host;
+            proxy_redirect http:// https://;
+        }
+
+        if ($accept_language ~ "^$") {
+            set $accept_language "en";
+        }
+
+        location /assets/img/custom {
+            alias /usr/share/nginx/html/en/assets/img/custom;
+        }
+
+        location = / {
+            root /usr/share/nginx/html/en;
+            try_files $uri $uri/ /index.html?$args;
+        }
+
+        location = /sign-in {
+            return 302 https://$host/api/v1/authn/saml/login;
+        }
+
+        location = /sign-up {
+            return 302 https://$host/api/v1/authn/saml/login;
+        }
+
+        location /redirect {
+            root /usr/share/nginx/html/en;
+            try_files $uri $uri/ /index.html?$args;
+        }
+
+        location ~ ^/(fr|de|it|pt|nl|ja|es|zh|pt|vi|id|hu|uk|bg) {
+            root /usr/share/nginx/html;
+            try_files $uri $uri/ /$1/index.html;
+        }
+
+        location ~ ^/(fr|de|it|pt|nl|ja|es|zh|pt|vi|id|hu|uk|bg)$ {
+           rewrite ^/(fr|de|it|pt|nl|ja|es|zh|pt|vi|id|hu|uk|bg)$ /$1/ permanent;
+        }
+
+        location ~* \.(css|js|jpg|jpeg|png|gif|ico|svg)$ {
+            root /usr/share/nginx/html/en;
+            add_header Pragma "no-cache";
+            add_header Expires "0";
+            add_header Cache-Control "public, max-age=31536000, immutable";
+        }
+
+        location / {
+           root /usr/share/nginx/html/en;
+           try_files $uri $uri/ /index.html?$args;
+        }
+
+        location /not-found {
+           root /usr/share/nginx/html/en;
+           try_files $uri $uri/ /index.html?$args =404;
+        }
+    }
+}
\ No newline at end of file
diff --git a/templates/nginx-config.yaml b/templates/nginx-config.yaml
new file mode 100644
index 0000000..866010a
--- /dev/null
+++ b/templates/nginx-config.yaml
@@ -0,0 +1,17 @@
+{{- if .Values.gentian.enabled }}
+{{- /*
+The nginx config Activepieces is served behind inside the Gentian portal.
+
+Kept as a real file under files/ rather than a string in this template so it stays
+reviewable and diffable; the AppProfile passes values, never a rendered config.
+*/}}
+apiVersion: v1
+kind: ConfigMap
+metadata:
+  name: {{ include "activepieces.fullname" . }}-gentian-runtime
+  labels:
+    {{- include "activepieces.labels" . | nindent 4 }}
+data:
+  nginx.conf: |
+{{ .Files.Get "files/nginx.conf" | indent 4 }}
+{{- end }}
diff --git a/values.yaml b/values.yaml
index 5bb9c4d..2a87101 100644
--- a/values.yaml
+++ b/values.yaml
@@ -727,3 +727,12 @@ redis:
     ## @param redis.auth.usePasswordFiles Mount credentials as files instead of using an environment variable
     ##
     usePasswordFiles: true
+
+## Gentian additions (not upstream) — see files/nginx.conf and files/entrypoint.sh.
+## Everything a Gentian AppProfile needs is a value here; profiles must never pass
+## `command` or `args`. Entrypoint ownership is L4 and belongs to the chart.
+##
+gentian:
+  ## @param gentian.enabled Serve the Gentian nginx config and entrypoint instead of the image defaults
+  ##
+  enabled: false
