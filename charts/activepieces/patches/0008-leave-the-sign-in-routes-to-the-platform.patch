--- /dev/null
+++ b/files/sign-in.js
@@ -0,0 +1,50 @@
+// Served to every page of Activepieces by files/nginx.conf.
+//
+// Activepieces' page keeps its session in localStorage ("token") and moves to
+// its own sign-in form when it finds none or finds it run out. Nobody has a
+// password to type there. This sends the browser to the platform's sign-in
+// instead, which is silent for a person signed in at the platform:
+//   - when a page loads with no token, or with one that has run out;
+//   - when the page's own script is about to show /sign-in or /sign-up;
+//   - when the token runs out while the page is open.
+(function () {
+  var login = '/sso/login';
+  function over(token) {
+    try {
+      var body = token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');
+      var claims = JSON.parse(atob(body));
+      return !claims.exp || claims.exp * 1000 <= Date.now();
+    } catch (e) {
+      return true;
+    }
+  }
+  function signedIn() {
+    var token = window.localStorage.getItem('token');
+    return !!token && !over(token);
+  }
+  function go() {
+    window.localStorage.removeItem('token');
+    window.localStorage.removeItem('currentUser');
+    window.location.replace(login);
+  }
+  if (!signedIn()) {
+    go();
+    return;
+  }
+  function leaving(url) {
+    return /(^|\/)sign-(in|up)([/?#]|$)/.test(String(url || ''));
+  }
+  ['pushState', 'replaceState'].forEach(function (name) {
+    var original = window.history[name];
+    window.history[name] = function (state, title, url) {
+      if (leaving(url)) {
+        go();
+        return;
+      }
+      return original.apply(this, arguments);
+    };
+  });
+  window.setInterval(function () {
+    if (!signedIn()) go();
+  }, 30000);
+})();
